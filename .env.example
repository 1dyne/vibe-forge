# 달그락 대장간 v0.5 - configuration template.
# Put real values in .env.local, never in this tracked example.
# Instructions: docs/SETUP-v0.5.md

APP_MODE=mock
APP_BASE_URL=http://localhost:3000

# Fill personally. Do not reuse these secrets across services.
APP_PASSWORD=
SESSION_SECRET=

# LLM credentials: worker only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Developer resolves valid model IDs and pricing before live mode.
OPENAI_MODEL_SMALL=
OPENAI_MODEL_LARGE=
OPENAI_MODEL_CODE=
ANTHROPIC_MODEL_SMALL=
ANTHROPIC_MODEL_LARGE=
ANTHROPIC_MODEL_CODE=

# User-authorized API spending limits (USD). 0 disables paid calls.
# Explicit Infinity removes this app's USD ceiling; provider account limits still apply.
LLM_COST_LIMIT_PER_TURN_USD=0
LLM_COST_LIMIT_PER_DAY_USD=0

# Set after a supported search adapter and its pricing are verified.
SEARCH_PROVIDER=disabled

# Local compose DB. Explicit DATABASE_URL_* overrides these defaults.
POSTGRES_USER=dalgeurak
POSTGRES_DB=dalgeurak_daejanggan
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL_WEB=
DATABASE_URL_WORKER=
DATABASE_URL_MIGRATIONS=

# Local storage is enough for development.
BLOB_STORE=local
BLOB_LOCAL_DIR=.data/blobs

# Optional remote storage. All values remain server-side.
SUPABASE_URL=
SUPABASE_SERVER_KEY=
SUPABASE_STORAGE_BUCKET=dalgeurak-private
